{
  "name": "@webergency-utils/client",
  "version": "0.0.3",
  "type": "module",
  "sideEffects": false,
  "description": "A fetch-based HTTP client with instance defaults, nested querystrings, form encoding, an opt-in cookie jar, and typed HTTP errors.",
  "author": "radixxko",
  "license": "MIT",
  "main": "dist/client.cjs",
  "module": "dist/client.js",
  "types": "dist/client.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "npm run build && vitest run",
    "test:bun": "bun --bun ./node_modules/vitest/vitest.mjs run",
    "fuzz": "npm run build && jazzer fuzz_client.cjs",
    "coverage": "npm run build && vitest run --coverage",
    "smoke": "node scripts/runtime-smoke.mjs",
    "smoke:bun": "bun scripts/runtime-smoke.mjs",
    "smoke:deno": "deno run --allow-read scripts/runtime-smoke.mjs",
    "clean": "rm -rf ./dist",
    "reset": "npm run clean && rm -rf node_modules package-lock.json && npm i",
    "build": "npm run clean && tsup",
    "commit": "node --input-type=module -e \"import { readFileSync } from 'node:fs'; import { execSync } from 'node:child_process'; const version = JSON.parse(readFileSync('./package.json', 'utf8')).version.trim(); execSync('git add . && git commit -m ' + JSON.stringify('Version ' + version), { stdio: 'inherit' });\"",
    "version": "npm run build && npm publish --access public && npm run commit && git push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webergency-utils/client.git"
  },
  "bugs": {
    "url": "https://github.com/webergency-utils/client/issues"
  },
  "homepage": "https://github.com/webergency-utils/client#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jazzer.js/core": "^4.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.4.1",
    "happy-dom": "^21.0.3",
    "tsup": "^9.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.18"
  }
}
